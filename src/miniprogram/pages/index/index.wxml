<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">川麻记账</text>
    <view class="history-btn" bindtap="goHistory">历史对局</view>
  </view>

  <!-- 玩家列表 -->
  <view class="players">
    <view class="player {{item.score > 0 ? 'winner' : 'loser'}}" wx:for="{{players}}" wx:key="name">
      <view class="player-info">
        <image class="avatar" src="{{item.avatar || '/images/default-avatar.png'}}" />
        <text class="name">{{item.name}}</text>
      </view>
      <text class="score {{item.score > 0 ? 'positive' : 'negative'}}">
        {{item.score > 0 ? '+' : ''}}{{item.score}}番
      </text>
    </view>
  </view>

  <!-- 局数统计 -->
  <view class="round-info">
    <text>已打 {{roundCount}} 局</text>
  </view>

  <!-- 语音按钮 -->
  <view class="voice-section">
    <view class="voice-btn {{recording ? 'recording' : ''}}" 
          bindtouchstart="startRecord" 
          bindtouchend="stopRecord">
      🎤 {{recording ? '松开结束' : '按住说话'}}
    </view>
  </view>

  <!-- 结算按钮 -->
  <view class="settle-btn" bindtap="goSettle">结束本局，去结算</view>
</view>
