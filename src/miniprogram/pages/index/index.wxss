.container {
  min-height: 100vh;
  padding: 20rpx;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
}

.history-btn {
  padding: 10rpx 30rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  font-size: 28rpx;
}

.players {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.player {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.player:last-child {
  border-bottom: none;
}

.player-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #e0e0e0;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
}

.score {
  font-size: 36rpx;
  font-weight: bold;
}

.score.positive {
  color: #1AAD19;
}

.score.negative {
  color: #E64340;
}

.player.winner {
  background: linear-gradient(90deg, rgba(26,173,25,0.1), transparent);
}

.player.loser {
  background: linear-gradient(90deg, rgba(230,67,64,0.1), transparent);
}

.round-info {
  text-align: center;
  padding: 20rpx;
  color: #666;
  font-size: 28rpx;
}

.voice-section {
  padding: 40rpx;
  text-align: center;
}

.voice-btn {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 30rpx rgba(26,173,25,0.3);
}

.voice-btn.recording {
  background: linear-gradient(135deg, #E64340, #FA5151);
  transform: scale(1.05);
  box-shadow: 0 8rpx 30rpx rgba(230,67,64,0.3);
}

.settle-btn {
  margin: 40rpx;
  padding: 30rpx;
  text-align: center;
  background: white;
  color: #1AAD19;
  border: 2rpx solid #1AAD19;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 500;
}
