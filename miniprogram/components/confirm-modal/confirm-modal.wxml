<view wx:if="{{visible}}" class="modal-mask">
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">AI理解为：</text>
      <text class="modal-summary">{{result.raw_summary}}</text>
    </view>

    <view class="score-list">
      <view wx:for="{{scoreNames}}" wx:key="*this" class="score-row">
        <text class="score-name">{{item}}</text>
        <view class="score-controls">
          <view class="adjust-btn" bindtap="adjustScore"
                data-name="{{item}}" data-delta="-1">
            <text>-</text>
          </view>
          <text class="score-value {{editableScores[item] > 0 ? 'score-positive' : editableScores[item] < 0 ? 'score-negative' : 'score-zero'}}">
            {{editableScores[item] > 0 ? '+' : ''}}{{editableScores[item]}}
          </text>
          <view class="adjust-btn" bindtap="adjustScore"
                data-name="{{item}}" data-delta="1">
            <text>+</text>
          </view>
        </view>
      </view>
    </view>

    <view class="modal-actions">
      <button class="modal-btn-cancel" bindtap="onCancel">重说</button>
      <button class="modal-btn-confirm" bindtap="onConfirm"
              disabled="{{!isBalanced}}">确认记录</button>
    </view>
  </view>
</view>
