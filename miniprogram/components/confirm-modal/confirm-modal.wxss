.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 16rpx;
}

.modal-summary {
  font-size: 28rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 20rpx;
  border-radius: 12rpx;
  display: block;
}

.score-list {
  margin-bottom: 30rpx;
}

.score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.score-name {
  font-size: 28rpx;
  font-weight: 500;
}

.score-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.adjust-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #6b7280;
}

.adjust-btn:active {
  background: #d1d5db;
}

.score-value {
  font-weight: bold;
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
}

.score-positive { color: #1AAD19; }
.score-negative { color: #E64340; }
.score-zero { color: #9CA3AF; }

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: 4rpx solid #e5e7eb;
  font-size: 30rpx;
  color: #6b7280;
  background: white;
}

.modal-btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1AAD19;
  color: white;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn-confirm[disabled] {
  opacity: 0.4;
}
