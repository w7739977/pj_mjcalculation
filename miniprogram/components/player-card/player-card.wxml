<view class="player-row {{player.score > 0 ? 'bg-green' : player.score < 0 ? 'bg-red' : ''}}">
  <view class="player-info">
    <view class="avatar">
      <text class="avatar-text">{{player.name[0]}}</text>
    </view>
    <text class="player-name">{{player.name}}</text>
    <text wx:if="{{player.name === myName}}" class="tag-me">(我)</text>
  </view>
  <view class="score-area">
    <text class="score {{player.score > 0 ? 'score-positive' : player.score < 0 ? 'score-negative' : 'score-zero'}}">
      {{player.score > 0 ? '+' : ''}}{{player.score}}番
    </text>
    <view wx:if="{{player.name !== myName}}" class="pay-btn" bindtap="onPayTap">
      <text class="pay-btn-text">+</text>
    </view>
  </view>
</view>
