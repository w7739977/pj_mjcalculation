/**app.wxss**/
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
  padding-bottom: 40rpx;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  color: white;
}

.btn-primary:active {
  background: linear-gradient(135deg, #179B15, #08A806);
}

.btn-secondary {
  background: white;
  color: #1AAD19;
  border: 4rpx solid #1AAD19;
}

.btn-secondary:active {
  background: #f0faf0;
}

.btn-danger {
  background: white;
  color: #E64340;
  border: 4rpx solid #E64340;
}

.btn-disabled {
  opacity: 0.4;
}

/* 卡片 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 分数颜色 */
.score-positive { color: #1AAD19; }
.score-negative { color: #E64340; }
.score-zero { color: #9CA3AF; }

/* 文本工具 */
.text-center { text-align: center; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 20rpx; }
.text-gray { color: #9CA3AF; }
.font-bold { font-weight: bold; }

/* Flex 工具 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }
.gap-sm { gap: 16rpx; }
