/**app.wxss**/
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

/* 全局样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
}

/* 按钮样式*/
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  color: white;
}

.btn-secondary {
  background: white;
  color: #1AAD19;
  border: 2rpx solid #1AAD19;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 分数显示 */
.score-positive {
  color: #1AAD19;
}

.score-negative {
  color: #E64340;
}
