.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.card {
  width: 100%;
  background: white;
  border-radius: 24rpx;
  padding: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.room-id-display {
  text-align: center;
  margin-bottom: 40rpx;
}

.room-id-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #1AAD19;
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 16rpx;
}

.room-id-label {
  font-size: 28rpx;
  color: #9CA3AF;
}

.error-box {
  background: #fef2f2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.error-text {
  color: #E64340;
  font-size: 28rpx;
}

.joined-box {
  text-align: center;
  padding: 40rpx 0;
}

.joined-icon {
  font-size: 80rpx;
  color: #1AAD19;
  display: block;
  margin-bottom: 20rpx;
}

.joined-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #1AAD19;
  display: block;
  margin-bottom: 16rpx;
}

.joined-sub {
  font-size: 28rpx;
  color: #9CA3AF;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  border: 4rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 36rpx;
  text-align: center;
  box-sizing: border-box;
}
