/* pages/confirm/confirm.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background: white;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 40rpx;
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.modal-body {
  padding: 40rpx;
}

.result-summary {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 15rpx;
}

.score-changes {
  margin-top: 20rpx;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.player-name {
  font-size: 32rpx;
  font-weight: 500;
}

.score-change {
  font-size: 36rpx;
  font-weight: bold;
}

.score-change.positive {
  color: #1AAD19;
}

.score-change.negative {
  color: #E64340;
}

.modal-footer {
  padding: 30rpx 40rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.btn-confirm, .btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-confirm {
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  color: white;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}
