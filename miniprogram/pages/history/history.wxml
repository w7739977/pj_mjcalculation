<view class="container">
  <nav-bar title="历史记录">
    <view slot="actions">
      <view class="nav-btn" bindtap="goBack">返回</view>
    </view>
  </nav-bar>

  <!-- Tabs -->
  <view class="tabs">
    <view class="tab {{activeTab === 'sessions' ? 'tab-active' : ''}}"
          bindtap="switchTab" data-tab="sessions">
      <text>历史对局</text>
    </view>
    <view class="tab {{activeTab === 'debts' ? 'tab-active' : ''}}"
          bindtap="switchTab" data-tab="debts">
      <text>欠账记录</text>
    </view>
  </view>

  <!-- Sessions Tab -->
  <view wx:if="{{activeTab === 'sessions'}}" class="content">
    <view wx:for="{{sessions}}" wx:key="id" class="card">
      <view class="session-header">
        <text class="session-date">{{item.dateFormatted}}</text>
        <text class="session-rounds">{{item.round_count || 0}}局</text>
      </view>
      <view class="score-tags">
        <view wx:for="{{item.total_scores}}" wx:for-index="name" wx:for-item="score"
              wx:key="name" class="score-tag">
          <text class="tag-name">{{name}}</text>
          <text class="tag-score {{score > 0 ? 'score-positive' : score < 0 ? 'score-negative' : 'score-zero'}}">
            {{score > 0 ? '+' : ''}}{{score}}
          </text>
        </view>
      </view>
    </view>
    <view wx:if="{{sessions.length === 0}}" class="empty">
      <text class="empty-text">暂无对局记录</text>
    </view>
  </view>

  <!-- Debts Tab -->
  <view wx:if="{{activeTab === 'debts'}}" class="content">
    <view wx:for="{{debtGroups}}" wx:key="key" class="card">
      <view class="debt-header">
        <view class="debt-names">
          <text class="debt-name">{{item.from}}</text>
          <text class="debt-label">欠</text>
          <text class="debt-name">{{item.to}}</text>
          <text class="debt-total">共 ¥{{item.total}}</text>
        </view>
        <view class="settle-btn" bindtap="settleDebt" data-group="{{item}}">
          <text class="settle-btn-text">标记已结清</text>
        </view>
      </view>
    </view>
    <view wx:if="{{debtGroups.length === 0}}" class="empty">
      <text class="empty-text">暂无欠账记录</text>
    </view>
  </view>
</view>
