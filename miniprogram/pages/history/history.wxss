.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
  padding-bottom: 60rpx;
}

.nav-btn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: white;
}

.tabs {
  display: flex;
  margin: 16rpx 30rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.3s;
}

.tab-active {
  background: white;
  color: #1AAD19;
  font-weight: 500;
  border-radius: 16rpx;
}

.content {
  padding: 0 30rpx;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.session-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.session-date {
  font-size: 26rpx;
  color: #6b7280;
}

.session-rounds {
  font-size: 24rpx;
  color: #9CA3AF;
}

.score-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.score-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-name {
  font-size: 26rpx;
  font-weight: 500;
}

.tag-score {
  font-size: 26rpx;
  font-weight: bold;
}

.score-positive { color: #1AAD19; }
.score-negative { color: #E64340; }
.score-zero { color: #9CA3AF; }

.debt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.debt-names {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.debt-name {
  font-size: 28rpx;
  font-weight: 500;
}

.debt-label {
  font-size: 28rpx;
  color: #9CA3AF;
}

.debt-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #E64340;
  margin-left: 16rpx;
}

.settle-btn {
  padding: 8rpx 20rpx;
  border: 2rpx solid #1AAD19;
  border-radius: 24rpx;
}

.settle-btn:active {
  background: #f0faf0;
}

.settle-btn-text {
  font-size: 24rpx;
  color: #1AAD19;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #9CA3AF;
  font-size: 28rpx;
}
