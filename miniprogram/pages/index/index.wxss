/* miniprogram/pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.history-btn {
  padding: 15rpx 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 28rpx;
  color: white;
}

/* 玩家列表 */
.players {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.player {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.player:last-child {
  border-bottom: none;
}

.player.winner {
  background: linear-gradient(90deg, rgba(26, 173, 25, 0.1), transparent);
}

.player.loser {
  background: linear-gradient(90deg, rgba(230, 67, 64, 0.1), transparent);
}

.player-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
}

.score {
  font-size: 36rpx;
  font-weight: bold;
}

.score.positive {
  color: #1AAD19;
}

.score.negative{
  color: #E64340;
}

/* 局数信息 */
.round-info {
  text-align: center;
  padding: 20rpx;
  color: #666;
  font-size: 28rpx;
}

/* 语音按钮 */
.voice-section {
  padding: 40rpx;
  text-align: center;
}

.voice-btn {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  border-radius: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: white;
  font-weight: bold;
  box-shadow: 0 10rpx 40rpx rgba(26, 173, 25, 0.3);
  transition: all 0.3s;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #E64340, #FA5151);
  transform: scale(1.05);
  box-shadow: 0 10rpx 40rpx rgba(230, 67, 64, 0.3);
}

/* 结算按钮 */
.settle-section {
  padding: 40rpx;
}

.settle-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: white;
  color: #1AAD19;
  border: 2rpx solid #1AAD19;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}
