.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.header-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.app-title {
  font-size: 72rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card {
  width: 100%;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  border: 4rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
}

.divider-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.footer-link {
  margin-top: 40rpx;
}

.footer-text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}
