<view class="container">
  <view class="header-section">
    <text class="app-title">川麻记账</text>
    <text class="app-subtitle">语音记账，轻松对局</text>
  </view>

  <view class="card">
    <view class="form-group">
      <text class="form-label">你的昵称</text>
      <input class="form-input" placeholder="输入昵称" maxlength="10"
             value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <button class="btn btn-primary" bindtap="createRoom"
            disabled="{{!nickname}}">创建房间</button>
  </view>

  <view class="card">
    <view class="divider-row">
      <view class="divider-line"></view>
      <text class="divider-text">或者</text>
      <view class="divider-line"></view>
    </view>
    <view class="form-group">
      <text class="form-label">房间号</text>
      <input class="form-input" placeholder="输入房间号" maxlength="36"
             value="{{joinRoomId}}" bindinput="onRoomIdInput" />
    </view>
    <button class="btn btn-secondary" bindtap="joinRoom"
            disabled="{{!joinRoomId}}">加入房间</button>
  </view>

  <view class="footer-link" bindtap="goTest">
    <text class="footer-text">测试页面</text>
  </view>
</view>