.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 20%);
  padding-bottom: 60rpx;
}

.header {
  padding: 40rpx 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.content {
  padding: 0 30rpx;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #374151;
  display: block;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #9CA3AF;
  display: block;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.mono {
  font-family: monospace;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preset-btn {
  padding: 10rpx 20rpx;
  background: #f3f4f6;
  border-radius: 20rpx;
}

.preset-btn:active {
  background: #e5e7eb;
}

.preset-text {
  font-size: 24rpx;
  color: #4b5563;
}

.btn-group {
  margin-bottom: 20rpx;
}

.btn-group .btn {
  margin-bottom: 16rpx;
}

.btn-outline {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  background: white;
  border: 4rpx solid #d1d5db;
  color: #4b5563;
}

.result-text {
  font-size: 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  max-height: 500rpx;
  overflow-y: auto;
}
