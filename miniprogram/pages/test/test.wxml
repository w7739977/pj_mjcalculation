<!--miniprogram/pages/test/test.wxml-->
<view class="test-container">
  <view class="test-header">
    <text class="title">本地测试模式</text>
    <text class="subtitle">无需云开发环境</text>
  </view>

  <!-- 测试状态 -->
  <view class="test-status">
    <view class="status-item">
      <text class="label">测试模式:</text>
      <text class="value">{{testMode ? '已启用' : '未启用'}}</text>
    </view>
    <view class="status-item">
      <text class="label">云环境:</text>
      <text class="value">{{cloudEnabled ? '已连接' : '未连接'}}</text>
    </view>
  </view>

  <!-- 模拟数据设置 -->
  <view class="mock-settings">
    <text class="section-title">模拟语音识别结果</text>
    <input class="mock-input" 
           placeholder="输入模拟语音文字" 
           value="{{mockVoiceText}}"
           bindinput="setMockVoice" />
    
    <text class="section-title">模拟AI解析结果</text>
    <textarea class="mock-textarea" 
              placeholder="JSON格式的AI解析结果"
              value="{{mockAIJson}}"
              bindinput="setMockAI" />
  </view>

  <!-- 测试按钮 -->
  <view class="test-buttons">
    <button class="test-btn" bindtap="runVoiceTest">测试语音识别</button>
    <button class="test-btn" bindtap="runAITest">测试AI解析</button>
    <button class="test-btn" bindtap="runFullTest">完整流程测试</button>
  </view>

  <!-- 测试结果 -->
  <view class="test-results" wx:if="{{testResult}}">
    <text class="result-title">测试结果</text>
    <text class="result-content">{{testResult}}</text>
  </view>
</view>
