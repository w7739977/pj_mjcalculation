<view class="container">
  <!-- Header -->
  <view class="header">
    <text class="title">测试页面</text>
  </view>

  <view class="content">
    <!-- Mock Voice -->
    <view class="card">
      <text class="card-title">模拟语音输入</text>
      <textarea class="textarea" value="{{mockVoiceText}}" bindinput="onVoiceInput"
                maxlength="200" auto-height />
      <view class="preset-row">
        <view wx:for="{{presets}}" wx:key="*this" class="preset-btn"
              bindtap="setPreset" data-text="{{item}}">
          <text class="preset-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- Mock AI -->
    <view class="card">
      <text class="card-title">模拟AI解析结果</text>
      <textarea class="textarea mono" value="{{mockAIJson}}" bindinput="onAIInput"
                maxlength="2000" auto-height />
    </view>

    <!-- Test Buttons -->
    <view class="btn-group">
      <button class="btn btn-secondary" bindtap="testVoice">测试语音识别（模拟）</button>
      <button class="btn btn-secondary" bindtap="testAI">测试AI解析（模拟）</button>
      <button class="btn btn-primary" bindtap="testFull">完整流程测试</button>
    </view>

    <!-- Result -->
    <view wx:if="{{testResult}}" class="card">
      <text class="card-title">测试结果</text>
      <text class="result-text">{{testResult}}</text>
    </view>

    <!-- API Test -->
    <view class="card">
      <text class="card-title">API连接测试</text>
      <button class="btn btn-outline" bindtap="testBackend">测试后端连接</button>
    </view>

    <!-- Quick Start -->
    <view class="card">
      <text class="card-title">快速开桌</text>
      <text class="card-desc">使用默认4人（张三/李四/王五/赵六）快速开始一局</text>
      <button class="btn btn-primary" bindtap="quickStart">快速开桌（默认4人）</button>
    </view>
  </view>
</view>
