.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
  padding-bottom: 60rpx;
}

.nav-btn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: white;
}

.base-info {
  text-align: center;
  padding: 8rpx;
}

.base-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card {
  margin: 16rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #374151;
  display: block;
  margin-bottom: 16rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-green {
  background: rgba(26, 173, 25, 0.05);
}

.rank-red {
  background: rgba(230, 67, 64, 0.05);
}

.rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}

.rank-gold {
  background: #FBBF24;
  color: #78350F;
}

.rank-gray {
  background: #e5e7eb;
  color: #4b5563;
}

.rank-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.rank-score-area {
  text-align: right;
}

.rank-score {
  font-weight: bold;
  font-size: 30rpx;
  display: block;
}

.rank-money {
  font-size: 24rpx;
  color: #9CA3AF;
}

.debt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.debt-row:last-child {
  border-bottom: none;
}

.debt-name {
  font-size: 28rpx;
  font-weight: 500;
}

.debt-arrow {
  color: #9CA3AF;
}

.debt-amount {
  margin-left: auto;
  font-weight: bold;
  color: #E64340;
  font-size: 28rpx;
}

.actions {
  padding: 30rpx;
}

.actions .btn {
  margin-bottom: 20rpx;
}

.btn-blue {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: #3B82F6;
  color: white;
}
