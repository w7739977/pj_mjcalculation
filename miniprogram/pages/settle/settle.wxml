<view class="container">
  <nav-bar title="对局结算">
    <view slot="actions">
      <view class="nav-btn" bindtap="goBack">返回</view>
    </view>
  </nav-bar>

  <view class="base-info">
    <text class="base-text">底分：1番 = 1元</text>
  </view>

  <!-- Ranking -->
  <view class="card">
    <view wx:for="{{sortedPlayers}}" wx:key="name"
          class="rank-row {{item.score > 0 ? 'rank-green' : item.score < 0 ? 'rank-red' : ''}}">
      <view class="rank-num {{index === 0 && item.score > 0 ? 'rank-gold' : 'rank-gray'}}">
        <text>{{index + 1}}</text>
      </view>
      <text class="rank-name">{{item.name}}</text>
      <view class="rank-score-area">
        <text class="rank-score {{item.score > 0 ? 'score-positive' : item.score < 0 ? 'score-negative' : 'score-zero'}}">
          {{item.score > 0 ? '+' : ''}}{{item.score}}番
        </text>
        <text class="rank-money">¥{{item.score}}</text>
      </view>
    </view>
  </view>

  <!-- Debts -->
  <view wx:if="{{debts.length > 0}}" class="card">
    <text class="section-title">欠账清单</text>
    <view wx:for="{{debts}}" wx:key="index" class="debt-row">
      <text class="debt-name">{{item.from}}</text>
      <text class="debt-arrow">→</text>
      <text class="debt-name">{{item.to}}</text>
      <text class="debt-amount">¥{{item.amount}}</text>
    </view>
  </view>

  <!-- Actions -->
  <view class="actions">
    <button class="btn btn-primary" bindtap="saveRecord">保存记录</button>
    <button wx:if="{{roomId}}" class="btn btn-blue" bindtap="backToRoom">返回房间开新一局</button>
    <button class="btn btn-secondary" bindtap="newGame">新开一局</button>
  </view>
</view>
