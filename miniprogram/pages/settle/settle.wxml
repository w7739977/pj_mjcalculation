<!--pages/settle/settle.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">对局结算</text>
    <text class="sub-title">底分：1番 = 1元</text>
  </view>

  <!-- 玩家排名 -->
  <view class="players">
    <view class="player {{item.score > 0 ? 'winner' : 'loser'}}" 
          wx:for="{{sortedPlayers}}" wx:key="name">
      <view class="rank">{{index + 1}}</view>
      <text class="name">{{item.name}}</text>
      <view class="scores">
        <text class="score">{{item.score > 0 ? '+' : ''}}{{item.score}}番</text>
        <text class="money">¥{{item.score > 0 ? '+' : ''}}{{item.score}}</text>
      </view>
      <text class="trophy" wx:if="{{index === 0 && item.score > 0}}">🏆</text>
    </view>
  </view>

  <!-- 欠账清单 -->
  <view class="debts-section" wx:if="{{debts.length > 0}}">
    <text class="section-title">欠账清单</text>
    <view class="debts">
      <view class="debt-item" wx:for="{{debts}}" wx:key="*this">
        <text class="debt-from">{{item.from}}</text>
        <text class="arrow">→</text>
        <text class="debt-to">{{item.to}}</text>
        <text class="debt-amount">¥{{item.amount}}</text>
        <button class="btn-settle" size="mini" bindtap="settleDebt" data-debt="{{item}}">结清</button>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-primary" bindtap="saveRecord">保存记录</button>
    <button class="btn-secondary" bindtap="newGame">新开一局</button>
  </view>
</view>
