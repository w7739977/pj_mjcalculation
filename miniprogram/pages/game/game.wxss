.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1AAD19 0%, #f5f5f5 30%);
  padding-bottom: 60rpx;
}

.nav-actions {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: white;
}

.players-card {
  margin: 16rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.round-info {
  text-align: center;
  padding: 20rpx;
}

.round-text {
  font-size: 26rpx;
  color: #6b7280;
}

.voice-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.voice-btn {
  width: 360rpx;
  height: 360rpx;
  border-radius: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1AAD19, #09BB07);
  box-shadow: 0 10rpx 40rpx rgba(26, 173, 25, 0.3);
  transition: all 0.3s;
}

.voice-btn-active {
  background: linear-gradient(135deg, #E64340, #FA5151);
  transform: scale(1.05);
  box-shadow: 0 10rpx 40rpx rgba(230, 67, 64, 0.3);
}

.voice-btn-text {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.settle-section {
  padding: 0 40rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.modal-content {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 100%;
  max-width: 600rpx;
}

.pay-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  display: block;
  margin-bottom: 8rpx;
}

.pay-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

.pay-input {
  border: 4rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e5e7eb;
  font-size: 30rpx;
  color: #6b7280;
  background: white;
  margin: 0;
  padding: 0;
}

.modal-btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1AAD19;
  color: white;
  font-size: 30rpx;
  font-weight: 500;
  margin: 0;
  padding: 0;
}

.modal-btn-confirm[disabled] {
  opacity: 0.4;
}

/* Identity Picker */
.identity-list {
  margin-top: 20rpx;
}

.identity-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  border: 4rpx solid #f3f4f6;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.identity-item:active {
  border-color: #1AAD19;
  background: #f0faf0;
}

.avatar-small {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(26, 173, 25, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #1AAD19;
}

.identity-name {
  font-size: 30rpx;
  font-weight: 500;
}
